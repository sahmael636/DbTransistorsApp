<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:DbTransistorsApp.Converters"
             x:Class="DbTransistorsApp.Views.EncapsuladoEditPage"
             Title="{Binding Title}">
    <ContentPage.Resources>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </ContentPage.Resources>
    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="14">
                <Label Text="Nombre del encapsulado *" FontAttributes="Bold"/>
                <Entry Text="{Binding Nombre}" Placeholder="Ej.: TO-92, SOT-23" BackgroundColor="White"/>

                <Label Text="Imagen PNG o JPG" FontAttributes="Bold" Margin="0,6,0,0"/>
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="7">
                    <Entry Text="{Binding Imagen}" IsReadOnly="True" Placeholder="Sin imagen" BackgroundColor="#F5F5F5"/>
                    <Button Grid.Column="1" Text="Seleccionar" Command="{Binding SelectImageCommand}"
                            BackgroundColor="#1976D2" TextColor="White" FontSize="11"/>
                    <Button Grid.Column="2" Text="Quitar" Command="{Binding RemoveImageCommand}"
                            BackgroundColor="#757575" TextColor="White" FontSize="11"/>
                </Grid>

                <Border HeightRequest="230" Padding="8" BackgroundColor="#F5F5F5" Stroke="#DDDDDD">
                    <Grid>
                        <Label Text="Vista previa" TextColor="Gray" FontSize="11"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                        <Image Source="{Binding ImagenPreview}" Aspect="AspectFit"/>
                    </Grid>
                </Border>
                <Label Text="La imagen se copiará al almacenamiento interno de la aplicación al guardar."
                       FontSize="10" TextColor="Gray"/>
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1" ColumnDefinitions="*,*" Padding="10" ColumnSpacing="10" BackgroundColor="#FAFAFA">
            <Button Text="Cancelar" Command="{Binding CancelCommand}" BackgroundColor="#616161" TextColor="White"/>
            <Button Grid.Column="1" Text="Guardar" Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                    BackgroundColor="#2E7D32" TextColor="White"/>
        </Grid>
    </Grid>
</ContentPage>
