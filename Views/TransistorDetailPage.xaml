<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:DbTransistorsApp.ViewModels"
             xmlns:models="clr-namespace:DbTransistorsApp.Models.Base"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="DbTransistorsApp.Views.TransistorDetailPage"
             x:Name="ThisPage"
             Title="{Binding TransistorName, StringFormat='Transistor {0}'}">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">
        <VerticalStackLayout Grid.Row="0" Padding="14,10,14,5" Spacing="4">
            <Label Text="{Binding TransistorName}" FontSize="22" FontAttributes="Bold"/>
            <Label Text="{Binding TransistorType, StringFormat='Tipo: {0}'}" FontSize="13" TextColor="Gray"/>
            <Label Text="{Binding TransistorStructure, StringFormat='Estructura: {0}'}" FontSize="13" TextColor="Gray"/>

            <Label Text="Encapsulados" FontSize="13" FontAttributes="Bold" Margin="0,5,0,0"/>
            <FlexLayout BindableLayout.ItemsSource="{Binding Encapsulados}"
                        Direction="Row" Wrap="Wrap">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:Encapsulado">
                        <Border Margin="0,0,8,6" Padding="9,5" Stroke="#BDBDBD" BackgroundColor="White">
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="{Binding Nombre}" FontSize="12" VerticalOptions="Center"/>
                                <Button Text="Imagen" FontSize="10" Padding="8,3"
                                        IsVisible="{Binding HasImage}"
                                        Command="{Binding BindingContext.ShowEncapsuladoImageCommand, Source={x:Reference ThisPage}}"
                                        CommandParameter="{Binding .}"/>
                            </HorizontalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>
        </VerticalStackLayout>

        <Border Grid.Row="1" Margin="10,2" Padding="0" Stroke="#D5D5D5" BackgroundColor="#F7F7F7">
            <VerticalStackLayout Spacing="0">
                <Grid Padding="12,9" BackgroundColor="#EEEEEE">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleParametersCommand}"/>
                    </Grid.GestureRecognizers>
                    <Label Text="{Binding ParametersToggleText}" FontAttributes="Bold" FontSize="14"/>
                </Grid>
                <VerticalStackLayout IsVisible="{Binding AreParametersExpanded}" Padding="8" Spacing="7">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Modifique valores y salga de la caja para actualizar reemplazos."
                               FontSize="10" TextColor="Gray" VerticalOptions="Center"/>
                        <Button Grid.Column="1" Text="Restablecer" Command="{Binding ResetToDefaultCommand}"
                                FontSize="11" Padding="10,5" BackgroundColor="#EF6C00" TextColor="White"/>
                    </Grid>
                    <CollectionView ItemsSource="{Binding Parameters}"
                                    ItemsLayout="VerticalGrid, 2"
                                    ItemSizingStrategy="MeasureAllItems"
                                    MaximumHeightRequest="390">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:TransistorParameter">
                                <Border Padding="4" StrokeThickness="0">
                                    <Grid RowDefinitions="Auto,Auto">
                                        <Label Text="{Binding DisplayName}" FontSize="11" FontAttributes="Bold"/>
                                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                                            <Entry Text="{Binding Value}" Keyboard="Numeric" FontSize="12" BackgroundColor="White">
                                                <Entry.Behaviors>
                                                    <toolkit:EventToCommandBehavior
                                                        EventName="Unfocused"
                                                        Command="{Binding BindingContext.ParameterChangedCommand, Source={x:Reference ThisPage}}"
                                                        CommandParameter="{Binding Name}"/>
                                                </Entry.Behaviors>
                                            </Entry>
                                            <Label Grid.Column="1" Text="{Binding Unit}" Margin="4,0,0,0"
                                                   FontSize="10" TextColor="Gray" VerticalOptions="Center"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>

        <Grid Grid.Row="2" Padding="12,7" ColumnDefinitions="*,Auto" BackgroundColor="#E3F2FD">
            <Label Text="Reemplazos disponibles" FontSize="15" FontAttributes="Bold"/>
            <Label Grid.Column="1" Text="{Binding ReplacementsSummary}"
                   FontSize="11" TextColor="Gray" VerticalOptions="Center"/>
        </Grid>

        <Grid Grid.Row="3">
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Always">
                <Grid WidthRequest="{Binding ReplacementsTableWidth}" RowDefinitions="Auto,*">
                    <Grid x:Name="ReplacementsHeader" Grid.Row="0" BackgroundColor="#1976D2"/>
                    <CollectionView x:Name="ReplacementsCollection"
                                    Grid.Row="1"
                                    ItemsSource="{Binding Replacements}"
                                    SelectionMode="None"/>
                </Grid>
            </ScrollView>
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
        </Grid>

        <Grid Grid.Row="4" Padding="10,5" IsVisible="{Binding HasMoreReplacements}"
              ColumnDefinitions="*,Auto" BackgroundColor="#F5F5F5">
            <Label Text="Los reemplazos se muestran por bloques para evitar bloqueos."
                   FontSize="10" TextColor="Gray" VerticalOptions="Center"/>
            <Grid Grid.Column="1">
                <Button Text="Cargar más" Command="{Binding LoadMoreReplacementsCommand}"
                        Padding="14,6" FontSize="12" BackgroundColor="#455A64" TextColor="White"/>
                <ActivityIndicator IsRunning="{Binding IsLoadingMoreReplacements}"
                                   IsVisible="{Binding IsLoadingMoreReplacements}"/>
            </Grid>
        </Grid>

        <Grid Grid.Row="5" Padding="8" ColumnDefinitions="*,*,*,*" ColumnSpacing="6" BackgroundColor="#FAFAFA">
            <Button Text="Editar" Command="{Binding EditCommand}" BackgroundColor="#1976D2" TextColor="White" FontSize="11"/>
            <Button Grid.Column="1" Text="Eliminar" Command="{Binding DeleteCommand}" BackgroundColor="#C62828" TextColor="White" FontSize="11"/>
            <Button Grid.Column="2" Text="PDF" Command="{Binding ExportToPdfCommand}" BackgroundColor="#6A1B9A" TextColor="White" FontSize="11"/>
            <Button Grid.Column="3" Text="Excel" Command="{Binding ExportToExcelCommand}" BackgroundColor="#2E7D32" TextColor="White" FontSize="11"/>
        </Grid>
    </Grid>
</ContentPage>
