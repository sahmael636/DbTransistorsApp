<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:DbTransistorsApp.ViewModels"
             xmlns:models="clr-namespace:DbTransistorsApp.Models.Base"
             xmlns:converters="clr-namespace:DbTransistorsApp.Converters"
             x:Class="DbTransistorsApp.Views.TransistorEditPage"
             x:Name="ThisPage"
             Title="{Binding Title}">
    <ContentPage.Resources>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="18" Spacing="12">
                <Border Padding="12" BackgroundColor="#E3F2FD" StrokeThickness="0">
                    <Label Text="{Binding TransistorType, StringFormat='Tipo: {0}'}"
                           FontAttributes="Bold" TextColor="#0D47A1"/>
                </Border>

                <Label Text="Nombre del transistor *" FontAttributes="Bold"/>
                <Entry Text="{Binding Name}" Placeholder="Ej.: 2N2222, IRF540" BackgroundColor="White"/>

                <Label Text="Estructura *" FontAttributes="Bold" Margin="0,6,0,0"/>
                <FlexLayout BindableLayout.ItemsSource="{Binding Estructuras}"
                            Direction="Row" Wrap="Wrap" JustifyContent="Start">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:Estructura">
                            <Border Margin="0,0,8,8" Padding="12,8"
                                    Stroke="{Binding BorderColor}"
                                    BackgroundColor="{Binding BackgroundColor}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding BindingContext.SelectEstructuraCommand, Source={x:Reference ThisPage}}"
                                        CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                                <Label Text="{Binding Nombre}" FontAttributes="Bold"/>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

                <Label Text="Características" FontSize="16" FontAttributes="Bold" Margin="0,8,0,0"/>
                <Label Text="Son opcionales; deje vacío un dato desconocido." FontSize="11" TextColor="Gray"/>
                <CollectionView ItemsSource="{Binding Parameters}"
                                ItemsLayout="VerticalGrid, 2"
                                ItemSizingStrategy="MeasureAllItems">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:ParameterField">
                            <Border Padding="5" StrokeThickness="0">
                                <Grid RowDefinitions="Auto,Auto">
                                    <Label Text="{Binding DisplayName}" FontSize="12" FontAttributes="Bold"/>
                                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                                        <Entry Text="{Binding Value}" Keyboard="{Binding InputKeyboard}" FontSize="13"
                                               Placeholder="Vacío" BackgroundColor="White"/>
                                        <Label Grid.Column="1" Text="{Binding Unit}" Margin="5,0,0,0"
                                               FontSize="11" TextColor="Gray" VerticalOptions="Center"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Text="Encapsulados (opcionales)" FontSize="16" FontAttributes="Bold" Margin="0,8,0,0"/>
                <Border Padding="12" Stroke="#D0D0D0" BackgroundColor="#FAFAFA">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Use el buscador con selección múltiple. La lista completa no se carga como botones."
                               FontSize="11" TextColor="Gray"/>
                        <Button Text="{Binding EncapsuladosButtonText}"
                                Command="{Binding SelectEncapsuladosCommand}"
                                BackgroundColor="#455A64" TextColor="White"/>
                        <Label Text="{Binding SelectedEncapsuladosSummary}"
                               FontSize="12" LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1" ColumnDefinitions="*,*" Padding="10" ColumnSpacing="10" BackgroundColor="#FAFAFA">
            <Button Text="Cancelar" Command="{Binding CancelCommand}" BackgroundColor="#616161" TextColor="White"/>
            <Button Grid.Column="1" Text="Guardar" Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                    BackgroundColor="#2E7D32" TextColor="White"/>
        </Grid>
    </Grid>
</ContentPage>
