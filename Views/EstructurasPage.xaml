<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:DbTransistorsApp.ViewModels"
             xmlns:models="clr-namespace:DbTransistorsApp.Models.Base"
             x:Class="DbTransistorsApp.Views.EstructurasPage"
             x:Name="ThisPage"
             Title="{Binding Title}">
    <Grid>
        <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding Estructuras}" Margin="10,8,10,85">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Estructura">
                        <Border Margin="0,4" Padding="14" Stroke="#DDDDDD" BackgroundColor="White">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                                <Border Padding="8,4" BackgroundColor="#E3F2FD" StrokeThickness="0">
                                    <Label Text="{Binding Id, StringFormat='ID {0}'}" FontAttributes="Bold" TextColor="#1565C0"/>
                                </Border>
                                <Label Grid.Column="1" Text="{Binding Nombre}" FontSize="17" FontAttributes="Bold"
                                       VerticalOptions="Center"/>
                                <Button Grid.Column="2" Text="Editar" FontSize="11" Padding="9,5"
                                        Command="{Binding BindingContext.EditEstructuraCommand, Source={x:Reference ThisPage}}"
                                        CommandParameter="{Binding .}"/>
                                <Button Grid.Column="3" Text="Eliminar" FontSize="11" Padding="9,5"
                                        BackgroundColor="#C62828" TextColor="White"
                                        Command="{Binding BindingContext.DeleteEstructuraCommand, Source={x:Reference ThisPage}}"
                                        CommandParameter="{Binding .}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <Button Text="＋" WidthRequest="60" HeightRequest="60" CornerRadius="30"
                HorizontalOptions="End" VerticalOptions="End" Margin="20"
                BackgroundColor="#2E7D32" TextColor="White" FontSize="25"
                Command="{Binding NewEstructuraCommand}"/>
    </Grid>
</ContentPage>
