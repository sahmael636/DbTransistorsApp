<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:DbTransistorsApp.ViewModels"
             xmlns:models="clr-namespace:DbTransistorsApp.Models.Base"
             xmlns:converters="clr-namespace:DbTransistorsApp.Converters"
             x:Class="DbTransistorsApp.Views.TransistorListPage"
             x:Name="ThisPage"
             Title="{Binding Title}">

    <ContentPage.Resources>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
        <Border Grid.Row="0"
                Margin="8,6,8,2"
                Padding="0"
                Stroke="#D5D5D5"
                StrokeThickness="1"
                BackgroundColor="#F7F7F7">
            <VerticalStackLayout Spacing="0">
                <Grid Padding="12,10" BackgroundColor="#EEEEEE">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleFiltersCommand}"/>
                    </Grid.GestureRecognizers>
                    <Label Text="{Binding FiltersToggleText}"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="#303030"/>
                </Grid>

                <VerticalStackLayout IsVisible="{Binding AreFiltersExpanded}"
                                     Padding="12,8,12,12"
                                     Spacing="8">
                    <Label Text="Estructura" FontSize="12" FontAttributes="Bold"/>
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="14"
                                               BindableLayout.ItemsSource="{Binding AvailableStructures}"
                                               RadioButtonGroup.GroupName="TransistorStructure"
                                               RadioButtonGroup.SelectedValue="{Binding SelectedStructure, Mode=TwoWay}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:Estructura">
                                    <RadioButton Content="{Binding Nombre}"
                                                 Value="{Binding .}"
                                                 FontSize="13"/>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>

                    <CollectionView ItemsSource="{Binding FilterFields}"
                                    ItemsLayout="VerticalGrid, 2"
                                    ItemSizingStrategy="MeasureAllItems"
                                    MaximumHeightRequest="390">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:FilterField">
                                <Border Padding="4" StrokeThickness="0">
                                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="2">
                                        <Label Text="{Binding DisplayName}" FontSize="11" FontAttributes="Bold"/>
                                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*">
                                            <Entry Grid.Column="0" Text="{Binding MinValue}" Placeholder="De"
                                                   Keyboard="Numeric" FontSize="12" BackgroundColor="White"/>
                                            <Label Grid.Column="1" Text="–" Margin="4,0" VerticalOptions="Center"/>
                                            <Entry Grid.Column="2" Text="{Binding MaxValue}" Placeholder="Hasta"
                                                   Keyboard="Numeric" FontSize="12" BackgroundColor="White"/>
                                        </Grid>
                                        <Label Grid.Row="2" Text="{Binding Unit}" FontSize="10"
                                               TextColor="Gray" HorizontalOptions="End"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Text="Aplicar filtros" Command="{Binding ApplyFiltersCommand}"
                                BackgroundColor="#1976D2" TextColor="White" FontSize="13"/>
                        <Button Grid.Column="1" Text="Limpiar" Command="{Binding ClearFiltersCommand}"
                                BackgroundColor="#EF6C00" TextColor="White" FontSize="13"/>
                    </Grid>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>

        <Grid Grid.Row="1" Padding="10,5" BackgroundColor="#E3F2FD" ColumnDefinitions="*,Auto">
            <Label Text="{Binding ResultsSummary}"
                   FontSize="13" FontAttributes="Bold"/>
            <Label Grid.Column="1" Text="{Binding TableDisplayName}" FontSize="11" TextColor="Gray"/>
        </Grid>

        <Grid Grid.Row="2">
            <ScrollView Orientation="Horizontal"
                        HorizontalScrollBarVisibility="Always"
                        VerticalScrollBarVisibility="Never">
                <Grid WidthRequest="{Binding TableWidth}" RowDefinitions="Auto,*">
                    <Grid x:Name="HeaderArea" Grid.Row="0" BackgroundColor="#1976D2"/>
                    <CollectionView x:Name="TransistorsCollection"
                                    Grid.Row="1"
                                    ItemsSource="{Binding Transistors}"
                                    SelectionMode="None"
                                    IsVisible="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"/>
                </Grid>
            </ScrollView>

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
        </Grid>

        <Grid Grid.Row="3" Padding="10,5" IsVisible="{Binding HasMoreResults}"
              ColumnDefinitions="*,Auto" BackgroundColor="#F5F5F5">
            <Label Text="La lista se carga por bloques para mantener la aplicación fluida."
                   FontSize="10" TextColor="Gray" VerticalOptions="Center"/>
            <Grid Grid.Column="1">
                <Button Text="Cargar más" Command="{Binding LoadMoreCommand}"
                        IsVisible="{Binding IsLoadingMore, Converter={StaticResource InverseBoolConverter}}"
                        Padding="14,6" FontSize="12"
                        BackgroundColor="#455A64" TextColor="White"/>
                <ActivityIndicator IsRunning="{Binding IsLoadingMore}"
                                   IsVisible="{Binding IsLoadingMore}"/>
            </Grid>
        </Grid>

        <Grid Grid.Row="4" ColumnDefinitions="*,*" ColumnSpacing="10"
              Padding="10,8" BackgroundColor="#FAFAFA">
            <Button Text="＋ Nuevo" Command="{Binding NewCommand}"
                    BackgroundColor="#2E7D32" TextColor="White"/>
            <Button Grid.Column="1" Text="⬆ Importar" Command="{Binding ImportCommand}"
                    BackgroundColor="#1565C0" TextColor="White"/>
        </Grid>
    </Grid>
</ContentPage>
